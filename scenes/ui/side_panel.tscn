[gd_scene format=3]

[node name="SidePanel" type="PanelContainer"]
custom_minimum_size = Vector2(300, 0)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="TV" type="ColorRect" parent="Margin/VBox"]
custom_minimum_size = Vector2(280, 210)
layout_mode = 2
color = Color(0.05, 0.05, 0.07, 1)

[node name="TVLabel" type="Label" parent="Margin/VBox/TV"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
text = "TV (placeholder)"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Info" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Arrow keys / WASD"
